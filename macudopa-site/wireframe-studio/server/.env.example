# MacuDopa Wireframe Studio — server env (copy to .env and fill in)
# Only the mock gateway is required; STRIPE_* / PAYPAL_* are reserved for a real PSP.
PORT=3001
DB_PATH=

# Active payment provider: mock | stripe | paypal  (default: mock)
PAYMENT_METHOD=mock

# JWT secrets — REQUIRED in production (NODE_ENV=production refuses to start
# without these; there is no hardcoded fallback in prod). Use long random values,
# e.g. `openssl rand -hex 32`.
# ACCESS_SECRET=
# REFRESH_SECRET=

# Optional: comma-allowed CORS origin allowlist. Leave unset to allow any origin
# (dev/preview). Set e.g. CORS_ORIGINS=https://studio.yourdomain.com to lock down.
# CORS_ORIGINS=

# Reserved — fill before switching PAYMENT_METHOD to stripe
STRIPE_SECRET_KEY=your-stripe-secret-key-here
# Reserved — fill before switching PAYMENT_METHOD to paypal
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here
