<footer class="site-footer" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-brand">
        <div class="brand" style="gap:12px;color:var(--precision-white)">
          {% render 'logo-mark', color: 'light' %}
          <span class="brand__word">{{ section.settings.logo_text }}</span>
        </div>
        <p class="footer-tag">{{ section.settings.tagline }}</p>
        <div class="footer-socials">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="6.5" width="17" height="11" rx="3"/><path d="M10.5 9.8v4.4l4-2.2-4-2.2Z" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 5v11a4 4 0 1 1-4-4"/><path d="M14 7c.5 2 2 3.4 4 3.6"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.about_header }}</h4>
        <ul>
          {%- for link in linklist[section.settings.about_linklist].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.help_header }}</h4>
        <ul>
          {%- for link in linklist[section.settings.help_linklist].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{{ section.settings.newsletter_header }}</h4>
        <p class="footer-tag" style="margin-bottom:16px">{{ section.settings.newsletter_copy }}</p>
        <form action="/contact" method="post" data-newsletter>
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
            aria-label="{{ 'general.newsletter.email_placeholder' | t }}"
            required
          >
          <button class="btn btn-orange" type="submit">{{ 'general.newsletter.subscribe' | t }}</button>
        </form>
        {%- if section.settings.club_link != blank -%}
          <ul style="margin-top:22px">
            <li><a href="{{ section.settings.club_link }}">{{ section.settings.club_label }}</a></li>
          </ul>
        {%- endif -%}
      </div>

    </div>

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.store_name }}. All rights reserved.</span>
      <div class="footer-legal">
        {%- for link in linklist[section.settings.legal_linklist].links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "MacuDopa" },
    { "type": "text", "id": "tagline", "label": "Brand tagline", "default": "Parkinson's support, grown from nature and refined by science. Natural, precise, and practitioner guided." },
    { "type": "header", "content": "Social links" },
    { "type": "text", "id": "instagram_url", "label": "Instagram URL", "default": "" },
    { "type": "text", "id": "youtube_url", "label": "YouTube URL", "default": "" },
    { "type": "text", "id": "tiktok_url", "label": "TikTok URL", "default": "" },
    { "type": "header", "content": "Menus" },
    { "type": "text", "id": "about_header", "label": "About column header", "default": "About" },
    { "type": "select", "id": "about_linklist", "label": "About menu", "default": "footer-about" },
    { "type": "text", "id": "help_header", "label": "Help column header", "default": "Help" },
    { "type": "select", "id": "help_linklist", "label": "Help menu", "default": "footer-help" },
    { "type": "text", "id": "newsletter_header", "label": "Newsletter column header", "default": "Stay in the loop" },
    { "type": "textarea", "id": "newsletter_copy", "label": "Newsletter copy", "default": "Sign up for all the latest info and offers in your inbox." },
    { "type": "select", "id": "legal_linklist", "label": "Legal menu", "default": "footer-legal" },
    { "type": "header", "content": "Club link" },
    { "type": "text", "id": "club_label", "label": "Club label", "default": "Club MacuDopa" },
    { "type": "text", "id": "club_link", "label": "Club URL", "default": "/pages/club-macudopa" }
  ],
  "presets": [
    { "name": "Footer" }
  ]
}
{% endschema %}
