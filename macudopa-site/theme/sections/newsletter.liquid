<section class="newsletter" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="newsletter-box">
      <div>
        <p class="sub">{{ section.settings.label }}</p>
        <h2 class="display" style="margin-top:14px">{{ section.settings.heading }}</h2>
      </div>
      <form action="/contact" method="post" data-newsletter aria-label="{{ section.settings.label }}">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" aria-label="{{ section.settings.placeholder }}" required>
        <button class="btn btn-primary" type="submit">{{ section.settings.button_label }}</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign up for the latest info and offers in your inbox." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
