{%- comment -%}
  Reusable MacuDopa pod logo mark.
  color: 'dark' (Macuna Purple) or 'light' (Precision White)
  size: pixel dimension, default 40
{%- endcomment -%}
<svg
  class="brand-mark brand-mark--{{ params.color }}"
  width="{{ params.size | default: 40 }}"
  height="{{ params.size | default: 40 }}"
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="24" cy="24" r="21.5" stroke="currentColor" stroke-width="1.6"/>
  <path d="M24 9.5 C 33.5 15.5 33.5 32.5 24 38.5 C 14.5 32.5 14.5 15.5 24 9.5 Z" stroke="currentColor" stroke-width="1.6"/>
  <circle cx="20.5" cy="20" r="2.4" fill="currentColor"/>
  <circle cx="27.5" cy="28" r="2.4" fill="currentColor"/>
</svg>
